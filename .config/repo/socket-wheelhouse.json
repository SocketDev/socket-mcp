{
  "ai": {
    "localAssist": true
  },
  "$schema": "./socket-wheelhouse-schema.json",
  "schemaVersion": 1,
  "repoName": "socket-mcp",
  "bundle": {
    "ref": "fleet-pack-765f1d4e74f6ebf418984daa19696ce15b1bd9d4",
    "cascadeSha": "765f1d4e74f6ebf418984daa19696ce15b1bd9d4"
  },
  "repo": {
    "type": "solo"
  },
  "build": {
    "from": "npm-registry",
    "type": "js",
    "bundlesVendoredDeps": true
  },
  "hooks": {
    "enablePrePush": true,
    "enableCommitMsg": true,
    "enablePreCommit": true,
    "preCommitVariant": "lint-test"
  },
  "scripts": {
    "optional": {
      "check": true,
      "clean": true,
      "cover": true,
      "fix": true,
      "security": true,
      "setup": false,
      "type": false,
      "update": true
    }
  },
  "lint": {
    "profile": "standard"
  },
  "workflows": {
    "ci": true,
    "provenance": false,
    "requirePinnedFullSha": true,
    "weeklyUpdate": true
  },
  "claude": {
    "includeSecurityScanSkill": true,
    "includeSharedSkills": true,
    "includeUpdatingSkill": true
  },
  "workspace": {
    "allowBuilds": {
      "@pnpm/exe": true,
      "esbuild": true
    },
    "blockExoticSubdeps": true,
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": ["@socketregistry/*", "@socketsecurity/*"],
    "resolutionMode": "highest",
    "trustPolicy": "no-downgrade"
  },
  "github": {
    "apps": ["cursor", "socket-security", "socket-trufflehog"]
  },
  "coverage": {
    "include": ["index.mts", "lib/**/*.mts", "hooks/**/*.mts"]
  },
  "vitest": {
    "lanes": {
      "mid": [
        "test/fleet/integration/**/*.test.mts",
        "test/integration/**/*.test.mts",
        "test/mock-client/**/*.test.mts"
      ],
      "slow": ["test/fleet/e2e/**/*.test.mts"]
    }
  }
}
